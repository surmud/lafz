  "id": "r06",
  "track": "reading",
  "order": 6,
  "title": "Vowels, ھ, ں and the two ye's",
  "emoji": "🔤",
  "tagline": "The little marks and special letters that make Urdu Urdu.",
  "canDo": "You can read short-vowel marks, do-chashmi he, nun ghunna and both ye's",
  "grammar": [
    {
      "title": "Cheat sheet",
      "body": "zabar َ = a · zer ِ = i · pesh ُ = u · ھ adds a puff of air (bh, ph, kh) · ں nasalises (main, hain) · ی = ee/y · ے = e/ai at the end of a word."
    }
  ],
