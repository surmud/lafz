    {
      "id": "r06-l3",
      "title": "Nun ghunna and the ye's",
      "blurb": "The nasal n, choti ye and bari ye.",
      "canDo": "You can read nasal endings and tell choti ye from bari ye",
      "teach": [
        {
          "title": "ں, ی and ے",
          "info": "ں (nun ghunna) has no dot: it just nasalises the vowel before it, as in main (میں), hain (ہیں). ی (choti ye) is 'ee' at the end (Nani نانی). ے (bari ye) swings back right and is 'e' or 'ai' at the end (hai ہے, kaise کیسے).",
          "glyph": "ں  ی  ے"
        },
        {
          "phrase": "r06.w-main"
        },
