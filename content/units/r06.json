  "lessons": [
    {
      "id": "r06-l1",
      "title": "Zabar, zer, pesh",
      "blurb": "Three tiny marks for short vowels (usually left out!)",
      "canDo": "You can read the three short-vowel marks",
      "teach": [
        {
          "title": "Short vowels are (mostly) invisible",
          "info": "Urdu writes long vowels as letters (ا و ی) but short vowels as tiny marks, and usually skips them. Zabar (a line above) = a, zer (a line below) = i, pesh (a little و above) = u. Beginners' books show them; WhatsApp never does.",
          "glyph": "بَ  بِ  بُ"
        },
        {
          "phrase": "r06.w-bas"
        },
        {
          "phrase": "r06.w-dil"
        },
