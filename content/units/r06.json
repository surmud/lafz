    {
      "id": "r06-l2",
      "title": "Do-chashmi he",
      "blurb": "The 'two-eyed h' that makes bh, ph, kh, gh, chh.",
      "canDo": "You can read aspirated sounds like bh, ph, kh",
      "teach": [
        {
          "title": "The two-eyed h",
          "info": "ھ (do-chashmi he, 'two-eyed he') never stands alone. It sits after a letter and adds a puff of air: ب + ھ = بھ (bh), پ + ھ = پھ (ph), ک + ھ = کھ (kh as in khana).",
          "glyph": "بھ  پھ  کھ  گھ  چھ"
        },
