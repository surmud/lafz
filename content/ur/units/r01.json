  "lessons": [
    {
      "id": "r01-l1",
      "title": "Meet the letters",
      "blurb": "6 letters: ا ب پ ت ٹ ث",
      "canDo": "You can recognise alif, be, pe, te, ṭe, se",
      "teach": [
        {
          "title": "Right to left",
          "info": "Urdu runs right to left, like Arabic and Persian. Books open from what English calls the back. Your eyes start on the right edge.",
          "glyph": "← ا ب پ"
        },
        {
          "phrase": "r01.l-alif",
          "tip": "Sounds like: long 'aa' (or a silent seat for a vowel). Its name is 'alif'."
        },
        {
          "phrase": "r01.l-be",
          "tip": "Sounds like: b. Its name is 'be'."
        },
        {
          "phrase": "r01.l-pe",
          "tip": "Sounds like: p. Its name is 'pe'."
        },
        {
          "phrase": "r01.l-te",
          "tip": "Sounds like: soft t (tongue on teeth). Its name is 'te'."
        },
        {
          "phrase": "r01.l-tte",
          "tip": "Sounds like: hard t (tongue curled back). Its name is 'ṭe'."
        },
        {
          "phrase": "r01.l-se",
          "tip": "Sounds like: s (Arabic loanwords). Its name is 'se'."
        }
      ],
