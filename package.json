{
  "name": "lafz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "serve": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "content:check": "tsx scripts/content-check.ts",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run content:check",
    "e2e": "playwright test",
    "budget": "node scripts/bundle-budget.mjs",
    "build:native": "rm -rf native-www && NEXT_PUBLIC_NATIVE=1 next build && NEXT_PUBLIC_NATIVE=1 node scripts/postbuild.mjs && mv out native-www && cap sync",
    "native:assets": "capacitor-assets generate --ios --android --assetPath native-assets --iconBackgroundColor '#0f7a73' --iconBackgroundColorDark '#0f7a73' --splashBackgroundColor '#fbf4e8' --splashBackgroundColorDark '#17110e'"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "idb": "^8.0.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
