# Public build configuration for Lafz (committed on purpose: every value here is public by design).
# Next.js loads this file for `next build`. Leave a value empty to keep that feature switched off.
# Secrets (Supabase service_role key, Stripe secret key, Apple private key) must NEVER go here.

# "Buy me a chai" Stripe Payment Link (web only; hidden in native builds).
NEXT_PUBLIC_CHAI_URL=https://buy.stripe.com/7sY3cxc8QbLK0ly7cQ1Nu00

# Supabase project (optional accounts). The publishable key is designed to be public; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://tcavluxpbwchtevumvlo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_0mg6DdTHX1ywVJS9UCmUtg_8-mcbgE-

# Sign in with Apple: set to 1 once the Apple provider is configured in Supabase.
NEXT_PUBLIC_APPLE_SIGNIN=

# Contact address shown on /privacy, /terms and /delete-account.
NEXT_PUBLIC_CONTACT_EMAIL=surmudjamil11+lafz@gmail.com

# Anonymous statistics endpoint (docs/TELEMETRY.md). Empty = nothing is ever sent.
NEXT_PUBLIC_TELEMETRY_URL=
